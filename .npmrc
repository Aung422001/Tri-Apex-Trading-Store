# Render sets NODE_ENV=production, which makes pnpm skip devDependencies.
# The whole build toolchain lives there — typescript and prisma for the
# backend, typescript, tailwindcss, postcss and autoprefixer for the
# frontend — and prisma and ts-node are needed at runtime too, by
# start:prod's migrate deploy and the seed script.
#
# This lives in the repo rather than as a --prod=false build flag so it
# applies no matter which build command Render actually runs.
production=false
