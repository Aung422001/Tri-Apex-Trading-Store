# ==============================================================
# TRIAPEX TRADING GROUP — Environment Variables Template
# ==============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file to version control!
# ==============================================================

# ─────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000
APP_NAME="Triapex Trading Group"
APP_URL=http://localhost:3000
API_URL=http://localhost:5000
API_PREFIX=/api/v1

# ─────────────────────────────────────────────
# DATABASE (PostgreSQL)
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/triapex_db
DATABASE_URL_SHADOW=postgresql://postgres:password@localhost:5432/triapex_db_shadow

# ─────────────────────────────────────────────
# REDIS (Cache & Sessions)
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TTL_DEFAULT=300

# ─────────────────────────────────────────────
# JWT AUTHENTICATION
# ─────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_token_secret_also_change_this_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_signing_secret_change_this

# ─────────────────────────────────────────────
# NEXTAUTH (Frontend)
# ─────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_run_openssl_rand_base64_32

# ─────────────────────────────────────────────
# GOOGLE OAUTH
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ─────────────────────────────────────────────
# GOOGLE GEMINI AI
# ─────────────────────────────────────────────
GEMINI_API_KEY=your_google_gemini_api_key_from_ai_studio
GEMINI_MODEL_FLASH=gemini-1.5-flash
GEMINI_MODEL_PRO=gemini-1.5-pro
GEMINI_MAX_TOKENS=1024
GEMINI_TEMPERATURE=0.7
GEMINI_DAILY_BUDGET_USD=10

# ─────────────────────────────────────────────
# STRIPE PAYMENTS
# ─────────────────────────────────────────────
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret
STRIPE_CURRENCY=myr

# ─────────────────────────────────────────────
# PAYPAL PAYMENTS
# ─────────────────────────────────────────────
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# ─────────────────────────────────────────────
# CLOUDINARY (Image Storage)
# ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=triapex_products

# ─────────────────────────────────────────────
# EMAIL (SendGrid / Nodemailer)
# ─────────────────────────────────────────────
SENDGRID_API_KEY=SG.your_sendgrid_api_key
EMAIL_FROM=noreply@triapextrading.com
EMAIL_FROM_NAME="Triapex Trading Group"
SUPPORT_EMAIL=support@triapextrading.com

# SMTP fallback (if not using SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ─────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000,https://triapextrading.com
CORS_CREDENTIALS=true

# ─────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AI_MAX=20

# ─────────────────────────────────────────────
# FILE UPLOAD
# ─────────────────────────────────────────────
MAX_FILE_SIZE_MB=5
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# ─────────────────────────────────────────────
# SHIPPING
# ─────────────────────────────────────────────
FREE_SHIPPING_THRESHOLD=500
DEFAULT_SHIPPING_COST=15
EXPRESS_SHIPPING_COST=35

# ─────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=dev

# ─────────────────────────────────────────────
# FRONTEND (Next.js Public Variables)
# ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# ─────────────────────────────────────────────
# ADMIN
# ─────────────────────────────────────────────
ADMIN_EMAIL=admin@triapextrading.com
ADMIN_DEFAULT_PASSWORD=ChangeThisPassword123!

# ─────────────────────────────────────────────
# MONITORING (Optional)
# ─────────────────────────────────────────────
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
VERCEL_ANALYTICS_ID=your_vercel_analytics_id
